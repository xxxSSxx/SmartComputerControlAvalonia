<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>SmartComputerControlAvalonia</RootNamespace>
    <AssemblyName>SmartComputerControl</AssemblyName>
    <!-- Icona embedded nell'eseguibile (visibile in Esplora Risorse + toast Windows) -->
    <ApplicationIcon>Assets\scc-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- TargetFrameworks condizionali per piattaforma:
       - Su Windows: net10.0 e net10.0-windows (WinForms+NotifyIcon)
       - Su Mac/Linux: solo net10.0 (notifiche via osascript / notify-send)
       Questo evita l'errore NETSDK1100 quando compili su Mac/Linux. -->
  <PropertyGroup Condition="'$([MSBuild]::IsOSPlatform(`Windows`))' == 'true'">
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$([MSBuild]::IsOSPlatform(`Windows`))' != 'true'">
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Solo per target Windows: abilitiamo WinForms per usare NotifyIcon con balloon nativi -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Copia anche il file .ico fisicamente nell'output, serve per NotifyIcon WinForms -->
    <None Include="Assets/scc-icon.ico" CopyToOutputDirectory="PreserveNewest">
      <Link>Assets\scc-icon.ico</Link>
    </None>
    <!-- Copia anche il .png fisicamente, serve per notify-send su Linux -->
    <None Include="Assets/scc-icon.png" CopyToOutputDirectory="PreserveNewest">
      <Link>Assets\scc-icon.png</Link>
    </None>
    <!-- Copia anche il file .png fisicamente nell'output, serve per notify-send su Linux -->
    <None Include="Assets/scc-icon.png" CopyToOutputDirectory="PreserveNewest">
      <Link>Assets\scc-icon.png</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <!-- Debug helpers (dev only) -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.0" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Override versione vulnerabile dependency transitiva -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <!-- NAudio: solo per Windows (mute/volume API) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="560"
        x:Class="SmartComputerControlAvalonia.Views.MainWindow"
        Title="SmartComputerControl"
        Icon="/Assets/scc-icon.ico"
        Width="560"
        SizeToContent="Height"
        MinHeight="500"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="14">

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="SmartComputerControl"
                           FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Spegnimento remoto via Dropbox / IFTTT"
                           FontSize="12" Foreground="Gray"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Separator />

            <!-- Cartella monitorata -->
            <StackPanel Spacing="6">
                <TextBlock Text="Cartella monitorata" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="CartellaBox"
                             Grid.Column="0"
                             IsReadOnly="True"
                             TextWrapping="NoWrap" />
                    <Button Content="Sfoglia..."
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="OnBrowseClicked" />
                </Grid>
            </StackPanel>

            <!-- Nome computer -->
            <StackPanel Spacing="6">
                <TextBlock Text="Nome computer (per ricevere comandi specifici)"
                           FontWeight="SemiBold" />
                <TextBox x:Name="NomeBox"
                         TextChanged="OnNomeChanged"
                         Watermark="es. Win11 oppure MacSe" />
            </StackPanel>

            <!-- Checkbox -->
            <CheckBox x:Name="PredefinitoCheck"
                      Content="Computer predefinito (accetta anche il comando 'google')"
                      IsCheckedChanged="OnPredefinitoChanged" />

            <CheckBox x:Name="AutoavvioCheck"
                      Content="Avvia automaticamente con il sistema"
                      IsCheckedChanged="OnAutoavvioChanged" />

            <CheckBox x:Name="ConfermaCheck"
                      Content="Mostra conferma prima dello spegnimento"
                      IsCheckedChanged="OnConfermaChanged" />

            <!-- Secondi di attesa -->
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           Text="Secondi di attesa:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <NumericUpDown Grid.Column="1"
                               x:Name="SecondiBox"
                               Minimum="5" Maximum="300"
                               Increment="5"
                               Width="140"
                               HorizontalAlignment="Left"
                               ValueChanged="OnSecondiChanged" />
            </Grid>

            <Separator />

            <!-- Help -->
            <Border Background="#15808080"
                    CornerRadius="6"
                    Padding="12,10">
                <TextBlock FontSize="12"
                           TextWrapping="Wrap"
                           Text="IFTTT crea un file .txt nella cartella monitorata. Il NOME del file determina quale PC esegue il comando (es. Win11.txt → Win11). Il CONTENUTO del file determina il comando: shutdown (o vuoto), restart, sleep, lock, mute, volume:50. Usa 'all.txt' per tutti, 'google.txt' per i PC predefiniti." />
            </Border>

            <TextBlock x:Name="StatusLabel"
                       Text="In esecuzione."
                       FontSize="12" Foreground="Green"
                       HorizontalAlignment="Center" />

        </StackPanel>
    </ScrollViewer>

</Window>

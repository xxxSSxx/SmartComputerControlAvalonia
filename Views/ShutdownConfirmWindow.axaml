<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartComputerControlAvalonia.Views.ShutdownConfirmWindow"
        Title="Spegnimento in arrivo"
        Width="480" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        SystemDecorations="Full"
        Icon="/Assets/scc-icon.ico"
        Background="#1E1E2E">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C62828" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#3A3A4A" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A5A" />
        </Style>
    </Window.Styles>

    <Grid Margin="30" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header con icona grande -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="18"
                    Margin="0,0,0,8">
            <Border Width="64" Height="64" CornerRadius="32"
                    Background="#E53935"
                    HorizontalAlignment="Left">
                <Viewbox Width="36" Height="36"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Icona power simbolico -->
                    <Canvas Width="24" Height="24">
                        <Path Stroke="White" StrokeThickness="2.5"
                              StrokeLineCap="Round"
                              Data="M 12 3 L 12 12 M 6.5 6.5 A 8 8 0 1 0 17.5 6.5" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Spegnimento computer"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="Comando di spegnimento remoto ricevuto"
                           FontSize="13" Foreground="#A0A0B0"
                           Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Row="1" Height="1" Background="#2A2A3A" Margin="0,12,0,0" />

        <!-- Countdown -->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,20,0,20">
            <TextBlock x:Name="CountdownText"
                       Text="Il computer si spegnerà tra 30 secondi"
                       FontSize="15"
                       Foreground="#E0E0F0"
                       HorizontalAlignment="Center" />
            <ProgressBar x:Name="CountdownBar"
                         Minimum="0" Maximum="30" Value="30"
                         Height="8"
                         Background="#2A2A3A"
                         Foreground="#E53935" />
            <TextBlock Text="Premi Annulla per impedire lo spegnimento"
                       FontSize="11"
                       Foreground="#808090"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1"
                    Content="Annulla"
                    Classes="secondary"
                    Click="OnCancelClicked"
                    Margin="0,0,10,0" />
            <Button Grid.Column="2"
                    Content="Spegni subito"
                    Classes="danger"
                    Click="OnShutdownNowClicked" />
        </Grid>

    </Grid>

</Window>
